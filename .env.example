# Modèle du fichier .env : CE fichier est commité, il ne contient que des valeurs bidon.
# Copie-le en .env (qui, lui, est ignoré par git) et remplis tes vraies valeurs.

CONTACT_NOM=Prénom Nom
CONTACT_TELEPHONE=06 00 00 00 00
CONTACT_EMAIL=moi@example.com

# Ton lien de partage DossierFacile. Ce n'est pas une "clé d'API", mais c'est un secret :
# quiconque a ce lien peut voir tes pièces justificatives.
DOSSIER_FACILE_URL=https://locataire.dossierfacile.logement.gouv.fr/file/xxxxxxxx
